<?xml version="1.0" encoding="utf-8" ?>
<!--
    Lists use BindableLayout inside ScrollView rather than CollectionView: on Windows the
    CollectionView rows stayed blank when items were added from the refresh timer.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HobbywingCan.App.ViewModels"
             xmlns:mon="clr-namespace:HobbywingCan.Core.Monitoring;assembly=HobbywingCan.Core"
             xmlns:loc="clr-namespace:HobbywingCan.App.Localization"
             x:Class="HobbywingCan.App.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{loc:Tr Ui_PageTitle}">

    <ContentPage.Resources>
        <!-- replaces the app-wide Label style, so it sets the text color again: with the app theme differing from
             Windows' (light app, dark Windows) the default text color would be the Windows one -->
        <Style x:Key="BaseLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />
        <Style x:Key="Header" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </Style>
        <Style x:Key="Section" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="Empty" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="HeaderRow" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="6" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
        </Style>
        <!-- replaces the app-wide Button style too, so the colors are set here for the same reason as for labels -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinimumHeightRequest" Value="32" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="HelpText" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="HelpParam" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalOptions" Value="Start" />
        </Style>
        <!-- one flight controller parameter of the ArduPilot popup -->
        <DataTemplate x:Key="FcParamRow" x:DataType="vm:FcParamRowViewModel">
            <Grid ColumnDefinitions="200,240,90,110,90" RowDefinitions="Auto,Auto" ColumnSpacing="8" Padding="6,2">
                <BoxView Grid.RowSpan="2" Grid.ColumnSpan="5" Color="{Binding MarkColor}" CornerRadius="4" Margin="-4,-2" />
                <Label Text="{Binding Name}" FontFamily="Consolas" />
                <Picker Grid.Column="1" MinimumHeightRequest="32" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                        IsVisible="{Binding HasOptions}" />
                <Entry Grid.Column="1" MinimumHeightRequest="32" Text="{Binding EditText}" Keyboard="Numeric" IsVisible="{Binding HasEntry}" />
                <Label Grid.Column="2" Text="{Binding CurrentText}" FontFamily="Consolas" HorizontalTextAlignment="End" />
                <Grid Grid.Column="3" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <Label Text="{Binding RecommendedText}" FontFamily="Consolas" HorizontalTextAlignment="End" />
                    <BoxView Grid.Column="1" Color="{Binding RecommendedColor}" WidthRequest="8" HeightRequest="8" CornerRadius="4" />
                </Grid>
                <Button Grid.Column="4" Text="{loc:Tr Ui_Set}" Command="{Binding SetCommand}" HeightRequest="32" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Note}" Style="{StaticResource HelpText}" FontSize="12" Opacity="0.75" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,4*" Padding="12" RowSpacing="4">

        <!-- Connection bar -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="{loc:Tr Ui_Port}" />
            <Picker ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" WidthRequest="130"
                    IsEnabled="{Binding IsDisconnected}" />
            <Button Text="↻" Command="{Binding RefreshPortsCommand}" ToolTipProperties.Text="{loc:Tr Tip_RefreshPorts}" />
            <Label Text="{loc:Tr Ui_Baud}" />
            <Picker ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" WidthRequest="110"
                    IsEnabled="{Binding IsDisconnected}" />
            <Label Text="{loc:Tr Ui_CanBus}" />
            <Picker ItemsSource="{Binding CanBuses}" SelectedItem="{Binding SelectedCanBus}" WidthRequest="70"
                    IsEnabled="{Binding IsDisconnected}" ToolTipProperties.Text="{loc:Tr Tip_CanBus}" />
            <Label Text="{loc:Tr Ui_AppNodeId}" />
            <Entry Text="{Binding LocalNodeIdText}" WidthRequest="60" Keyboard="Numeric" IsEnabled="{Binding IsDisconnected}"
                   ToolTipProperties.Text="{loc:Tr Tip_AppNodeId}" />
            <CheckBox IsChecked="{Binding UseFilter}" IsEnabled="{Binding IsDisconnected}" />
            <Label Text="{loc:Tr Ui_UseFilter}" ToolTipProperties.Text="{loc:Tr Tip_UseFilter}" />
            <CheckBox IsChecked="{Binding PollEscIds}" />
            <Label Text="{loc:Tr Ui_PollEscIds}" ToolTipProperties.Text="{loc:Tr Tip_PollEscIds}" />
            <Button Text="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" WidthRequest="120" />
            <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" WidthRequest="140"
                    ToolTipProperties.Text="{loc:Tr Tip_Language}" />
            <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" WidthRequest="140"
                    ToolTipProperties.Text="{loc:Tr Tip_Theme}" />
            <Button Text="{loc:Tr Ui_ArduPilotHelp}" Command="{Binding OpenArduPilotHelpCommand}"
                    ToolTipProperties.Text="{loc:Tr Tip_ArduPilotHelp}" />
        </HorizontalStackLayout>

        <!-- Status -->
        <HorizontalStackLayout Grid.Row="1" Spacing="20">
            <Label Text="{Binding VehicleText}" FontAttributes="Bold" />
            <Label Text="{Binding StatsText}" FontFamily="Consolas" FontSize="12" />
        </HorizontalStackLayout>

        <!-- ESC table -->
        <Label Grid.Row="2" Text="{loc:Tr Ui_EscSection}" Style="{StaticResource Section}" />
        <Grid Grid.Row="3" ColumnDefinitions="45,110,45,55,50,40,60,60,55,120,70,210,60,60,60,130,*" Style="{StaticResource HeaderRow}">
            <Label Grid.Column="0" Text="{loc:Tr Ui_Node}" Style="{StaticResource Header}" />
            <Label Grid.Column="1" Text="{loc:Tr Ui_Name}" Style="{StaticResource Header}" />
            <Label Grid.Column="2" Text="{loc:Tr Ui_ThrCh}" Style="{StaticResource Header}" />
            <Label Grid.Column="3" Text="RPM" Style="{StaticResource Header}" />
            <Label Grid.Column="4" Text="PWM" Style="{StaticResource Header}" />
            <Label Grid.Column="5" Text="{loc:Tr Ui_Dir}" Style="{StaticResource Header}"
                   ToolTipProperties.Text="{loc:Tr Tip_Dir}" />
            <Label Grid.Column="6" Text="{loc:Tr Ui_Voltage}" Style="{StaticResource Header}" />
            <Label Grid.Column="7" Text="{loc:Tr Ui_Current}" Style="{StaticResource Header}" />
            <Label Grid.Column="8" Text="{loc:Tr Ui_Temp}" Style="{StaticResource Header}" />
            <Label Grid.Column="9" Text="{loc:Tr Ui_ExtraTemps}" Style="{StaticResource Header}" />
            <Label Grid.Column="10" Text="{loc:Tr Ui_Status}" Style="{StaticResource Header}" />
            <Label Grid.Column="11" Text="{loc:Tr Ui_Health}" Style="{StaticResource Header}"
                   ToolTipProperties.Text="{loc:Tr Tip_Health}" />
            <Label Grid.Column="12" Text="{loc:Tr Ui_Msg1Set}" Style="{StaticResource Header}" ToolTipProperties.Text="{loc:Tr Tip_Msg1Set}" />
            <Label Grid.Column="13" Text="{loc:Tr Ui_Msg2Set}" Style="{StaticResource Header}" ToolTipProperties.Text="{loc:Tr Tip_Msg2Set}" />
            <Label Grid.Column="14" Text="{loc:Tr Ui_Msg3Set}" Style="{StaticResource Header}" ToolTipProperties.Text="{loc:Tr Tip_Msg3Set}" />
            <Label Grid.Column="15" Text="{loc:Tr Ui_Measured}" Style="{StaticResource Header}" ToolTipProperties.Text="{loc:Tr Tip_Measured}" />
            <Label Grid.Column="16" Text="{loc:Tr Ui_Updated}" Style="{StaticResource Header}" />
        </Grid>
        <ScrollView Grid.Row="4">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding EscRows}">
                <BindableLayout.EmptyView>
                    <Label Text="{loc:Tr Ui_NoEscs}"
                           Style="{StaticResource Empty}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EscRowViewModel">
                        <Grid ColumnDefinitions="45,110,45,55,50,40,60,60,55,120,70,210,60,60,60,130,*" ColumnSpacing="6" Padding="6,3">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Label Grid.Column="0" Text="{Binding NodeId}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding Name}" />
                            <Label Grid.Column="2" Text="{Binding ThrottleChannel}" />
                            <Label Grid.Column="3" Text="{Binding Rpm}" FontFamily="Consolas" />
                            <Label Grid.Column="4" Text="{Binding Pwm}" FontFamily="Consolas" />
                            <Label Grid.Column="5" Text="{Binding Direction}" />
                            <Label Grid.Column="6" Text="{Binding Voltage}" FontFamily="Consolas" />
                            <Label Grid.Column="7" Text="{Binding Current}" FontFamily="Consolas" />
                            <Label Grid.Column="8" Text="{Binding Temperature}" FontFamily="Consolas" />
                            <Label Grid.Column="9" Text="{Binding ExtraTemperatures}" FontFamily="Consolas" />
                            <Label Grid.Column="10" Text="{Binding Status}" FontFamily="Consolas" />
                            <!-- fixed-width ESC count first, so the health text after it never moves -->
                            <Grid Grid.Column="11" ColumnDefinitions="16,52,*" ColumnSpacing="2">
                                <Label Text="{Binding EscCount.Icon}" TextColor="{Binding EscCount.Color}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding EscCount.Text}" TextColor="{Binding EscCount.Color}" />
                                <Label Grid.Column="2" Text="{Binding Health}" />
                            </Grid>
                            <Label Grid.Column="12" Text="{Binding Msg1Set}" FontFamily="Consolas" />
                            <Label Grid.Column="13" Text="{Binding Msg2Set}" FontFamily="Consolas" />
                            <Label Grid.Column="14" Text="{Binding Msg3Set}" FontFamily="Consolas" />
                            <Label Grid.Column="15" Text="{Binding Rates}" FontSize="12" />
                            <Label Grid.Column="16" Text="{Binding Age}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom: configuration | autopilot telemetry + log | bus traffic -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*" ColumnSpacing="16">

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <Label Grid.Row="0" Text="{loc:Tr Ui_ApTelemetry}" Style="{StaticResource Section}"
                       ToolTipProperties.Text="{loc:Tr Tip_ApTelemetry}" />
                <Grid Grid.Row="1" ColumnDefinitions="50,55,70,65,50,70,*" Style="{StaticResource HeaderRow}">
                    <Label Grid.Column="0" Text="ESC" Style="{StaticResource Header}" />
                    <Label Grid.Column="1" Text="RPM" Style="{StaticResource Header}" />
                    <Label Grid.Column="2" Text="{loc:Tr Ui_Voltage}" Style="{StaticResource Header}" />
                    <Label Grid.Column="3" Text="{loc:Tr Ui_Current}" Style="{StaticResource Header}" />
                    <Label Grid.Column="4" Text="{loc:Tr Ui_Temp}" Style="{StaticResource Header}" />
                    <Label Grid.Column="5" Text="{loc:Tr Ui_Consumed}" Style="{StaticResource Header}" />
                    <Label Grid.Column="6" Text="{loc:Tr Ui_Count}" Style="{StaticResource Header}" />
                </Grid>
                <VerticalStackLayout Grid.Row="2" BindableLayout.ItemsSource="{Binding AutopilotRows}">
                    <BindableLayout.EmptyView>
                        <Label Text="{loc:Tr Ui_NoApTelemetry}" Style="{StaticResource Empty}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AutopilotEscRowViewModel">
                            <Grid ColumnDefinitions="50,55,70,65,50,70,*" ColumnSpacing="6" Padding="6,2">
                                <Label Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Rpm}" FontFamily="Consolas" />
                                <Label Grid.Column="2" Text="{Binding Voltage}" FontFamily="Consolas" />
                                <Label Grid.Column="3" Text="{Binding Current}" FontFamily="Consolas" />
                                <Label Grid.Column="4" Text="{Binding Temperature}" FontFamily="Consolas" />
                                <Label Grid.Column="5" Text="{Binding Consumed}" FontFamily="Consolas" />
                                <Label Grid.Column="6" Text="{Binding Count}" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Row="3" Spacing="10">
                    <Label Text="{loc:Tr Ui_Log}" Style="{StaticResource Section}" />
                    <Button Text="{loc:Tr Ui_Clear}" Command="{Binding ClearLogCommand}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <ScrollView Grid.Row="4">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Log}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontFamily="Consolas" FontSize="12" LineBreakMode="WordWrap" Padding="4,1" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <Label Grid.Row="0" Text="{loc:Tr Ui_Traffic}" Style="{StaticResource Section}" />
                <Grid Grid.Row="1" ColumnDefinitions="40,40,*,65,70,40" Style="{StaticResource HeaderRow}">
                    <Label Grid.Column="0" Text="{loc:Tr Ui_Node}" Style="{StaticResource Header}" />
                    <Label Grid.Column="1" Text="{loc:Tr Ui_Kind}" Style="{StaticResource Header}" />
                    <Label Grid.Column="2" Text="{loc:Tr Ui_DataType}" Style="{StaticResource Header}" />
                    <Label Grid.Column="3" Text="{loc:Tr Ui_Rate}" Style="{StaticResource Header}" />
                    <Label Grid.Column="4" Text="{loc:Tr Ui_Count}" Style="{StaticResource Header}" />
                    <Label Grid.Column="5" Text="{loc:Tr Ui_Last}" Style="{StaticResource Header}" />
                </Grid>
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TrafficRows}">
                        <BindableLayout.EmptyView>
                            <Label Text="{loc:Tr Ui_NoTraffic}" Style="{StaticResource Empty}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrafficRowViewModel">
                                <Grid ColumnDefinitions="40,40,*,65,70,40" ColumnSpacing="6" Padding="6,1">
                                    <Label Grid.Column="0" Text="{Binding NodeId}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding KindText}" FontSize="12" />
                                    <Label Grid.Column="2" Text="{Binding TypeText}" FontSize="12" />
                                    <Label Grid.Column="3" Text="{Binding Rate}" FontFamily="Consolas" FontSize="12" />
                                    <Label Grid.Column="4" Text="{Binding Count}" FontFamily="Consolas" FontSize="12" />
                                    <Label Grid.Column="5" Text="{Binding Age}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                <VerticalStackLayout Grid.Row="0">
                    <Label Text="{loc:Tr Ui_EscConfig}" Style="{StaticResource Section}" />
                    <!-- FlexLayout rows wrap instead of pushing the page wider than the window -->
                    <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <Button Text="↻" Command="{Binding ReadConfigCommand}" Margin="0,0,6,0"
                                ToolTipProperties.Text="{loc:Tr Tip_ReadConfig}" />
                        <Button Text="{loc:Tr Ui_CopyReport}" Command="{Binding CopyReportCommand}" Margin="0,0,6,0" />
                        <!-- fixed width: "Report" and "Edit" must not move the buttons after it -->
                        <Button Text="{Binding ToggleViewText}" Command="{Binding ToggleViewCommand}" Margin="0,0,6,0" WidthRequest="90"
                                ToolTipProperties.Text="{loc:Tr Tip_ToggleView}" />
                        <Button Text="{loc:Tr Ui_Presets}" Command="{Binding OpenPresetsCommand}"
                                ToolTipProperties.Text="{loc:Tr Tip_Presets}" />
                    </FlexLayout>
                </VerticalStackLayout>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,70,Auto" ColumnSpacing="10">
                    <Label Text="{loc:Tr Ui_Node}" />
                    <Picker MinimumHeightRequest="32" Grid.Column="1" ItemsSource="{Binding ConfigNodes}" SelectedItem="{Binding SelectedConfigNode}" />
                    <Label Grid.Column="2" TextColor="{Binding SelectedEscCount.Color}"
                           ToolTipProperties.Text="{loc:Tr Tip_EscCountWrite}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding SelectedEscCount.Icon}" FontAttributes="Bold" />
                                <Span Text=" " />
                                <Span Text="{Binding SelectedEscCount.Text}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <ActivityIndicator Grid.Column="3" IsRunning="{Binding IsWriting}" HeightRequest="20" WidthRequest="20" />
                </Grid>

                <!-- Read-only report -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6" IsVisible="{Binding ShowReport}">
                    <HorizontalStackLayout Grid.Row="0" Spacing="6">
                        <CheckBox MinimumHeightRequest="32" IsChecked="{Binding IncludeParameters}" />
                        <Label Text="{loc:Tr Ui_IncludeParams}" ToolTipProperties.Text="{loc:Tr Tip_IncludeParams}" />
                        <ActivityIndicator IsRunning="{Binding IsReading}" HeightRequest="20" WidthRequest="20" />
                        <Label Text="{Binding ConfigProgress}" />
                    </HorizontalStackLayout>
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConfigItems}">
                            <BindableLayout.EmptyView>
                                <Label Text="{loc:Tr Ui_ConfigEmpty}"
                                       Style="{StaticResource Empty}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="mon:ConfigItem">
                                    <Grid ColumnDefinitions="100,170,*" ColumnSpacing="8" Padding="6,2">
                                        <Label Grid.Column="0" Text="{Binding Group}" FontSize="12" Opacity="0.65" />
                                        <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas" LineBreakMode="CharacterWrap" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <!-- Settings (writes to the ESC) -->
                <ScrollView Grid.Row="2" IsVisible="{Binding ShowSettings}">
                    <!-- keep every row narrow: wide content here widens all three bottom columns -->
                    <!-- compact rows (32 px, not the app's 44) so all fields fit without scrolling -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*,70"
                          RowSpacing="2" ColumnSpacing="8" Padding="0,0,8,0">
                        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="3" Spacing="2">
                            <Label Style="{StaticResource Empty}" Margin="0" Text="{loc:Tr Ui_MarksLegend}"
                                   ToolTipProperties.Text="{loc:Tr Tip_MarksLegend}" />
                            <Label Style="{StaticResource Empty}" Margin="0" Text="{Binding SettingsHint}" IsVisible="{Binding HasSettingsHint}"
                                   ToolTipProperties.Text="{loc:Tr Tip_SettingsHint}" />
                        </VerticalStackLayout>

                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Color="{Binding Marks[NewNodeIdText]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="1" Text="{loc:Tr Ui_NodeId}" />
                        <Entry MinimumHeightRequest="32" Grid.Row="1" Grid.Column="1" Text="{Binding NewNodeIdText}" Keyboard="Numeric" />
                        <Button Padding="8,2" Grid.Row="1" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetNodeIdCommand}" />

                        <BoxView Grid.Row="2" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedCanBaud]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="2" Text="{loc:Tr Ui_CanSpeed}"
                               ToolTipProperties.Text="{loc:Tr Tip_CanSpeed}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CanBaudOptions}" SelectedItem="{Binding SelectedCanBaud}" />
                        <Button Padding="8,2" Grid.Row="2" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetCanBaudCommand}" />

                        <BoxView Grid.Row="3" Grid.ColumnSpan="2" Color="{Binding Marks[ThrottleChannelText]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="3" Text="{loc:Tr Ui_ThrottleChannel}" ToolTipProperties.Text="{loc:Tr Tip_ThrottleChannel}" />
                        <Entry MinimumHeightRequest="32" Grid.Row="3" Grid.Column="1" Text="{Binding ThrottleChannelText}" Keyboard="Numeric" />
                        <Button Padding="8,2" Grid.Row="3" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetThrottleChannelCommand}" />

                        <BoxView Grid.Row="4" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedThrottleSource]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="4" Text="{loc:Tr Ui_ThrottleSource}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ThrottleSourceOptions}" SelectedItem="{Binding SelectedThrottleSource}" />
                        <Button Padding="8,2" Grid.Row="4" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetThrottleSourceCommand}" />

                        <BoxView Grid.Row="5" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedMsg1Rate]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="5" Text="{loc:Tr Ui_Msg1Rate}" ToolTipProperties.Text="{loc:Tr Tip_Msg1}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding SelectedMsg1Rate}" />
                        <Button Padding="8,2" Grid.Row="5" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetRateCommand}" CommandParameter="1" />

                        <BoxView Grid.Row="6" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedMsg2Rate]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="6" Text="{loc:Tr Ui_Msg2Rate}" ToolTipProperties.Text="{loc:Tr Tip_Msg2}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="6" Grid.Column="1" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding SelectedMsg2Rate}" />
                        <Button Padding="8,2" Grid.Row="6" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetRateCommand}" CommandParameter="2" />

                        <BoxView Grid.Row="7" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedMsg3Rate]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="7" Text="{loc:Tr Ui_Msg3Rate}" ToolTipProperties.Text="{loc:Tr Tip_Msg3}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="7" Grid.Column="1" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding SelectedMsg3Rate}" />
                        <Button Padding="8,2" Grid.Row="7" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetRateCommand}" CommandParameter="3" />

                        <BoxView Grid.Row="8" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedLedColor]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="8" Text="{loc:Tr Ui_LedColor}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="8" Grid.Column="1" ItemsSource="{Binding LedColorOptions}" SelectedItem="{Binding SelectedLedColor}" />

                        <BoxView Grid.Row="9" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedLedBlink]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="9" Text="{loc:Tr Ui_LedMode}" />
                        <HorizontalStackLayout Grid.Row="9" Grid.Column="1" Spacing="6">
                            <Picker MinimumHeightRequest="32" ItemsSource="{Binding LedBlinkOptions}" SelectedItem="{Binding SelectedLedBlink}" WidthRequest="120" />
                            <CheckBox MinimumHeightRequest="32" IsChecked="{Binding LedSave}" />
                            <Label Text="{loc:Tr Ui_Save}" />
                        </HorizontalStackLayout>
                        <Button Padding="8,2" Grid.Row="9" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetLedCommand}" />

                        <BoxView Grid.Row="10" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedDirection]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="10" Text="{loc:Tr Ui_Direction}" />
                        <Picker MinimumHeightRequest="32" Grid.Row="10" Grid.Column="1" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" />
                        <Button Padding="8,2" Grid.Row="10" Grid.Column="2" Text="{loc:Tr Ui_Set}" Command="{Binding SetDirectionCommand}" />
                    </Grid>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Presets popup: an overlay over the whole page, no extra package needed -->
        <Grid Grid.RowSpan="6" Margin="-12" ZIndex="10" BackgroundColor="#99000000" IsVisible="{Binding ShowPresets}">
            <Border WidthRequest="600" HorizontalOptions="Center" VerticalOptions="Center" Padding="12"
                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView>
                    <!-- right padding: the scroll bar is drawn over the content -->
                    <VerticalStackLayout Spacing="6" Padding="0,0,18,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{loc:Tr Ui_PresetsTitle}" Style="{StaticResource Section}" Margin="0" />
                            <!-- every popup button: the same size, in one column at the right edge -->
                            <Button Grid.Column="1" Text="{loc:Tr Ui_Close}" Command="{Binding ClosePresetsCommand}"
                                    HeightRequest="32" WidthRequest="110" VerticalOptions="Center" />
                        </Grid>

                        <!-- the same selection as the page: the ESC whose values are shown on the right and that Apply writes to -->
                        <!-- the Node and Preset rows share their columns, so both pickers are the same width -->
                        <Grid ColumnDefinitions="50,*,70,20,110" ColumnSpacing="8">
                            <Label Text="{loc:Tr Ui_Node}" />
                            <Picker MinimumHeightRequest="32" Grid.Column="1" ItemsSource="{Binding ConfigNodes}" SelectedItem="{Binding SelectedConfigNode}" />
                            <Label Grid.Column="2" TextColor="{Binding SelectedEscCount.Color}"
                                   ToolTipProperties.Text="{loc:Tr Tip_EscCountApply}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SelectedEscCount.Icon}" FontAttributes="Bold" />
                                        <Span Text=" " />
                                        <Span Text="{Binding SelectedEscCount.Text}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <ActivityIndicator Grid.Column="3" IsRunning="{Binding IsWriting}" HeightRequest="20" WidthRequest="20" />
                            <Button Grid.Column="4" Text="{loc:Tr Ui_Apply}" Command="{Binding ApplyPresetCommand}"
                                    HeightRequest="32" WidthRequest="110" VerticalOptions="Center" />
                        </Grid>
                        <Label Style="{StaticResource Empty}" Margin="0"
                               Text="{loc:Tr Ui_ApplyHint}" />

                        <Grid ColumnDefinitions="50,*,70,20,110" ColumnSpacing="8">
                            <Label Text="{loc:Tr Ui_Preset}" />
                            <Picker MinimumHeightRequest="32" Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" />
                            <Button Grid.Column="4" Text="{loc:Tr Ui_Delete}" Command="{Binding DeletePresetCommand}"
                                    HeightRequest="32" WidthRequest="110" VerticalOptions="Center" />
                        </Grid>

                        <Label Style="{StaticResource Empty}" Margin="0"
                               Text="{loc:Tr Ui_PresetLegend}" />

                        <!-- the same fields and order as the settings editor; on the right what the selected ESC reports now -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,120,*,120"
                              RowSpacing="2" ColumnSpacing="6">
                            <Label Grid.Row="0" Grid.Column="2" Text="{loc:Tr Ui_Preset}" FontSize="12" Opacity="0.65" />
                            <Label Grid.Row="0" Grid.Column="3" Text="{loc:Tr Ui_Now}" HorizontalTextAlignment="End" FontSize="12" Opacity="0.65" />

                            <BoxView Grid.Row="1" Grid.ColumnSpan="4" Color="{Binding DraftMarks[NodeIdText]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="1" IsChecked="{Binding Draft.IncludeNodeId}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{loc:Tr Ui_NodeId}" ToolTipProperties.Text="1..127" />
                            <Entry MinimumHeightRequest="32" Grid.Row="1" Grid.Column="2" Text="{Binding Draft.NodeIdText}" Keyboard="Numeric" />
                            <Label Grid.Row="1" Grid.Column="3" Text="{Binding PresetCurrent[NodeIdText]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="2" Grid.ColumnSpan="4" Color="{Binding DraftMarks[CanBaud]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="2" IsChecked="{Binding Draft.IncludeCanBaud}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{loc:Tr Ui_CanSpeed}" ToolTipProperties.Text="{loc:Tr Tip_CanSpeedMatch}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="2" Grid.Column="2" ItemsSource="{Binding CanBaudOptions}" SelectedItem="{Binding Draft.CanBaud}" />
                            <Label Grid.Row="2" Grid.Column="3" Text="{Binding PresetCurrent[CanBaud]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center"
                                   ToolTipProperties.Text="{loc:Tr Tip_CanSpeedNoRead}" />

                            <BoxView Grid.Row="3" Grid.ColumnSpan="4" Color="{Binding DraftMarks[ThrottleChannelText]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="3" IsChecked="{Binding Draft.IncludeThrottleChannel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{loc:Tr Ui_ThrottleChannel}" ToolTipProperties.Text="{loc:Tr Tip_ThrottleChannelRange}" />
                            <Entry MinimumHeightRequest="32" Grid.Row="3" Grid.Column="2" Text="{Binding Draft.ThrottleChannelText}" Keyboard="Numeric" />
                            <Label Grid.Row="3" Grid.Column="3" Text="{Binding PresetCurrent[ThrottleChannelText]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="4" Grid.ColumnSpan="4" Color="{Binding DraftMarks[ThrottleSource]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="4" IsChecked="{Binding Draft.IncludeThrottleSource}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{loc:Tr Ui_ThrottleSource}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ThrottleSourceOptions}" SelectedItem="{Binding Draft.ThrottleSource}" />
                            <Label Grid.Row="4" Grid.Column="3" Text="{Binding PresetCurrent[ThrottleSource]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="5" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Msg1Rate]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="5" IsChecked="{Binding Draft.IncludeMsg1Rate}" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{loc:Tr Ui_Msg1Rate}" ToolTipProperties.Text="{loc:Tr Tip_Msg1}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="5" Grid.Column="2" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Draft.Msg1Rate}" />
                            <Label Grid.Row="5" Grid.Column="3" Text="{Binding PresetCurrent[Msg1Rate]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="6" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Msg2Rate]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="6" IsChecked="{Binding Draft.IncludeMsg2Rate}" />
                            <Label Grid.Row="6" Grid.Column="1" Text="{loc:Tr Ui_Msg2Rate}" ToolTipProperties.Text="{loc:Tr Tip_Msg2}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="6" Grid.Column="2" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Draft.Msg2Rate}" />
                            <Label Grid.Row="6" Grid.Column="3" Text="{Binding PresetCurrent[Msg2Rate]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="7" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Msg3Rate]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="7" IsChecked="{Binding Draft.IncludeMsg3Rate}" />
                            <Label Grid.Row="7" Grid.Column="1" Text="{loc:Tr Ui_Msg3Rate}" ToolTipProperties.Text="{loc:Tr Tip_Msg3}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="7" Grid.Column="2" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Draft.Msg3Rate}" />
                            <Label Grid.Row="7" Grid.Column="3" Text="{Binding PresetCurrent[Msg3Rate]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <!-- one tick for colour and mode: SetLED writes both -->
                            <BoxView Grid.Row="8" Grid.ColumnSpan="4" Color="{Binding DraftMarks[LedColor]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="8" IsChecked="{Binding Draft.IncludeLed}" />
                            <Label Grid.Row="8" Grid.Column="1" Text="{loc:Tr Ui_LedColor}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="8" Grid.Column="2" ItemsSource="{Binding LedColorOptions}" SelectedItem="{Binding Draft.LedColor}" />
                            <Label Grid.Row="8" Grid.Column="3" Text="{Binding PresetCurrent[LedColor]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="9" Grid.ColumnSpan="4" Color="{Binding DraftMarks[LedBlink]}" CornerRadius="4" Margin="-4,-2" />
                            <Label Grid.Row="9" Grid.Column="1" Text="{loc:Tr Ui_LedMode}" />
                            <HorizontalStackLayout Grid.Row="9" Grid.Column="2" Spacing="6">
                                <Picker MinimumHeightRequest="32" ItemsSource="{Binding LedBlinkOptions}" SelectedItem="{Binding Draft.LedBlink}" WidthRequest="140" />
                                <CheckBox MinimumHeightRequest="32" IsChecked="{Binding Draft.LedSave}" />
                                <Label Text="{loc:Tr Ui_Save}" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="9" Grid.Column="3" Text="{Binding PresetCurrent[LedBlink]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />

                            <BoxView Grid.Row="10" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Direction]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox MinimumHeightRequest="32" Grid.Row="10" IsChecked="{Binding Draft.IncludeDirection}" />
                            <Label Grid.Row="10" Grid.Column="1" Text="{loc:Tr Ui_Direction}" />
                            <Picker MinimumHeightRequest="32" Grid.Row="10" Grid.Column="2" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Draft.Direction}" />
                            <Label Grid.Row="10" Grid.Column="3" Text="{Binding PresetCurrent[Direction]}" FontFamily="Consolas" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </Grid>

                        <!-- what Save would change in the chosen saved preset -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasPresetChanges}">
                            <Label Text="{loc:Tr Ui_PresetChanges}" FontSize="12" Opacity="0.65" />
                            <Label Text="{Binding PresetChanges}" FontFamily="Consolas" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="{loc:Tr Ui_Name}" />
                            <Entry MinimumHeightRequest="32" Grid.Column="1" Text="{Binding PresetName}" Placeholder="{loc:Tr Ui_PresetNamePlaceholder}" />
                            <Button Grid.Column="2" Text="{loc:Tr Ui_Save}" Command="{Binding SavePresetCommand}"
                                    HeightRequest="32" WidthRequest="110" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ArduPilot setup popup: parameter names and values stay as ArduPilot spells them, only the notes are translated.
             Connected, it reads the flight controller parameters and writes them (PARAM_SET); otherwise it is a reference. -->
        <Grid Grid.RowSpan="6" Margin="-12" ZIndex="10" BackgroundColor="#99000000" IsVisible="{Binding ShowArduPilotHelp}">
            <Border WidthRequest="1000" Margin="0,24" HorizontalOptions="Center" VerticalOptions="Center" Padding="12"
                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView>
                    <!-- right padding: the scroll bar is drawn over the content -->
                    <VerticalStackLayout Spacing="6" Padding="0,0,18,0">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{loc:Tr Help_Title}" Style="{StaticResource Section}" Margin="0" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding FcBusy}" HeightRequest="20" WidthRequest="20" />
                            <Button Grid.Column="2" Text="{loc:Tr Ui_ReadFc}" Command="{Binding ReadFcParamsCommand}"
                                    HeightRequest="32" WidthRequest="110" VerticalOptions="Center" ToolTipProperties.Text="{loc:Tr Tip_ReadFc}" />
                            <Button Grid.Column="3" Text="{loc:Tr Ui_RebootFc}" Command="{Binding RebootFcCommand}"
                                    HeightRequest="32" MinimumWidthRequest="110" VerticalOptions="Center" ToolTipProperties.Text="{loc:Tr Tip_RebootFc}" />
                            <Button Grid.Column="4" Text="{loc:Tr Ui_Close}" Command="{Binding CloseArduPilotHelpCommand}"
                                    HeightRequest="32" WidthRequest="110" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{loc:Tr Help_Intro}" Style="{StaticResource HelpText}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding FcStatus}" Style="{StaticResource HelpText}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{loc:Tr Ui_ApplyRecommended}" Command="{Binding ApplyRecommendedFcCommand}"
                                    HeightRequest="32" VerticalOptions="Center" ToolTipProperties.Text="{loc:Tr Tip_ApplyRecommended}" />
                        </Grid>
                        <Label Text="{loc:Tr Fc_RebootNeeded}" Style="{StaticResource HelpText}" FontAttributes="Bold" TextColor="#E0A000"
                               IsVisible="{Binding FcRebootNeeded}" />
                        <Label Style="{StaticResource Empty}" Margin="0" Text="{loc:Tr Ui_FcLegend}" />

                        <Grid ColumnDefinitions="200,240,90,110,90" ColumnSpacing="8" Style="{StaticResource HeaderRow}">
                            <Label Text="{loc:Tr Ui_FcParam}" Style="{StaticResource Header}" />
                            <Label Grid.Column="1" Text="{loc:Tr Ui_FcNew}" Style="{StaticResource Header}" />
                            <Label Grid.Column="2" Text="{loc:Tr Ui_FcNow}" Style="{StaticResource Header}" HorizontalTextAlignment="End" />
                            <Label Grid.Column="3" Text="{loc:Tr Ui_FcRecommended}" Style="{StaticResource Header}" HorizontalTextAlignment="End" />
                        </Grid>

                        <Label Text="{loc:Tr Fc_GroupCanPort}" Style="{StaticResource Section}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding FcCanPortRows}"
                                             BindableLayout.ItemTemplate="{StaticResource FcParamRow}" />

                        <Label Text="{loc:Tr Fc_GroupDroneCan}" Style="{StaticResource Section}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding FcDroneCanRows}"
                                             BindableLayout.ItemTemplate="{StaticResource FcParamRow}" />

                        <Label Text="{loc:Tr Fc_GroupFrame}" Style="{StaticResource Section}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding FcFrameRows}"
                                             BindableLayout.ItemTemplate="{StaticResource FcParamRow}" />

                        <!-- BetaFlight X Reversed from above, nose up -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,6,0,0">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="150,60,150" RowSpacing="6">
                                <Label Grid.ColumnSpan="3" Text="{loc:Tr Fc_Front}" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="{Binding MotorFrontLeft}" FontFamily="Consolas" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding MotorFrontRight}" FontFamily="Consolas" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="2" Grid.Column="1" Text="✕" FontSize="28" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="3" Text="{Binding MotorRearLeft}" FontFamily="Consolas" HorizontalTextAlignment="Center" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding MotorRearRight}" FontFamily="Consolas" HorizontalTextAlignment="Center" />
                            </Grid>
                            <Label Grid.Column="1" Text="{loc:Tr Fc_MotorsText}" Style="{StaticResource HelpText}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="200,*" ColumnSpacing="8" Margin="0,6,0,0">
                            <Label Text="INS_HNTCH_MODE = 3" Style="{StaticResource HelpParam}" />
                            <Label Grid.Column="1" Text="{loc:Tr Help_Notch}" Style="{StaticResource HelpText}" />
                        </Grid>

                        <Label Text="{loc:Tr Help_EscSection}" Style="{StaticResource Section}" />
                        <Label Text="{loc:Tr Help_EscText}" Style="{StaticResource HelpText}" />

                        <Label Text="{loc:Tr Help_AppSection}" Style="{StaticResource Section}" />
                        <Label Text="{loc:Tr Help_AppText}" Style="{StaticResource HelpText}" />

                        <Label Text="{loc:Tr Help_CheckSection}" Style="{StaticResource Section}" />
                        <Label Text="{loc:Tr Help_CheckText}" Style="{StaticResource HelpText}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
