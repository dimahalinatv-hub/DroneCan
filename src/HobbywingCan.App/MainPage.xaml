<?xml version="1.0" encoding="utf-8" ?>
<!--
    Lists use BindableLayout inside ScrollView rather than CollectionView: on Windows the
    CollectionView rows stayed blank when items were added from the refresh timer.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HobbywingCan.App.ViewModels"
             xmlns:mon="clr-namespace:HobbywingCan.Core.Monitoring;assembly=HobbywingCan.Core"
             x:Class="HobbywingCan.App.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Hobbywing X8 G2 — DroneCAN via ArduPilot">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="Header" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </Style>
        <Style x:Key="Section" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="Empty" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="HeaderRow" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="6" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinimumHeightRequest" Value="32" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,4*" Padding="12" RowSpacing="4">

        <!-- Connection bar -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Port" />
            <Picker ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" WidthRequest="130"
                    IsEnabled="{Binding IsDisconnected}" />
            <Button Text="↻" Command="{Binding RefreshPortsCommand}" ToolTipProperties.Text="Refresh COM ports" />
            <Label Text="Baud" />
            <Picker ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaud}" WidthRequest="110"
                    IsEnabled="{Binding IsDisconnected}" />
            <Label Text="FC CAN bus" />
            <Picker ItemsSource="{Binding CanBuses}" SelectedItem="{Binding SelectedCanBus}" WidthRequest="70"
                    IsEnabled="{Binding IsDisconnected}" ToolTipProperties.Text="Physical CAN port: CAN1 = CAN_P1, CAN2 = CAN_P2" />
            <Label Text="App node ID" />
            <Entry Text="{Binding LocalNodeIdText}" WidthRequest="60" Keyboard="Numeric" IsEnabled="{Binding IsDisconnected}"
                   ToolTipProperties.Text="DroneCAN node ID used by this app for requests; must be unused on the bus" />
            <CheckBox IsChecked="{Binding UseFilter}" IsEnabled="{Binding IsDisconnected}" />
            <Label Text="Forward only ESC traffic" ToolTipProperties.Text="Sends CAN_FILTER_MODIFY so the FC forwards only the DroneCAN types this app decodes (hides everything else from Bus traffic)" />
            <CheckBox IsChecked="{Binding PollEscIds}" />
            <Label Text="Poll GetEscID" ToolTipProperties.Text="Broadcast com.hobbywing.esc.GetEscID once a second while disarmed to learn throttle channels" />
            <Button Text="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" WidthRequest="120" />
        </HorizontalStackLayout>

        <!-- Status -->
        <HorizontalStackLayout Grid.Row="1" Spacing="20">
            <Label Text="{Binding VehicleText}" FontAttributes="Bold" />
            <Label Text="{Binding StatsText}" FontFamily="Consolas" FontSize="12" />
        </HorizontalStackLayout>

        <!-- ESC table -->
        <Label Grid.Row="2" Text="DroneCAN ESCs (live, decoded from forwarded CAN frames)" Style="{StaticResource Section}" />
        <Grid Grid.Row="3" ColumnDefinitions="45,110,45,45,55,50,40,60,60,60,55,120,70,130,60,60,60,130,*" Style="{StaticResource HeaderRow}">
            <Label Grid.Column="0" Text="Node" Style="{StaticResource Header}" />
            <Label Grid.Column="1" Text="Name" Style="{StaticResource Header}" />
            <Label Grid.Column="2" Text="Thr ch" Style="{StaticResource Header}" />
            <Label Grid.Column="3" Text="Thr src" Style="{StaticResource Header}" ToolTipProperties.Text="Throttle source from GetMajorConfig, or from the ESC's answer to the last Set: CAN (DroneCAN) or PWM. – = unknown" />
            <Label Grid.Column="4" Text="RPM" Style="{StaticResource Header}" />
            <Label Grid.Column="5" Text="PWM" Style="{StaticResource Header}" />
            <Label Grid.Column="6" Text="Dir" Style="{StaticResource Header}"
                   ToolTipProperties.Text="Direction setting reported by the ESC (SetDirection query / GetMajorConfig). Physical rotation also depends on motor phase wiring." />
            <Label Grid.Column="7" Text="Voltage" Style="{StaticResource Header}" />
            <Label Grid.Column="8" Text="Current" Style="{StaticResource Header}" />
            <Label Grid.Column="9" Text="Power" Style="{StaticResource Header}" />
            <Label Grid.Column="10" Text="Temp" Style="{StaticResource Header}" />
            <Label Grid.Column="11" Text="MOS / CAP / Motor" Style="{StaticResource Header}" />
            <Label Grid.Column="12" Text="Status" Style="{StaticResource Header}" />
            <Label Grid.Column="13" Text="Health / mode" Style="{StaticResource Header}"
                   ToolTipProperties.Text="⚠ shared node ID? = several ESCs answer as this node. ⚠ answers for others = this ESC answered a request addressed to another node." />
            <Label Grid.Column="14" Text="Msg1 set" Style="{StaticResource Header}" ToolTipProperties.Text="StatusMsg1 (RPM, PWM, status) rate configured in the ESC" />
            <Label Grid.Column="15" Text="Msg2 set" Style="{StaticResource Header}" ToolTipProperties.Text="StatusMsg2 (voltage, current, temperature) rate configured in the ESC" />
            <Label Grid.Column="16" Text="Msg3 set" Style="{StaticResource Header}" ToolTipProperties.Text="StatusMsg3 (MOS / CAP / motor temperatures) rate configured in the ESC" />
            <Label Grid.Column="17" Text="Measured, Hz" Style="{StaticResource Header}" ToolTipProperties.Text="Rates actually received from the ESC" />
            <Label Grid.Column="18" Text="Updated" Style="{StaticResource Header}" />
        </Grid>
        <ScrollView Grid.Row="4">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding EscRows}">
                <BindableLayout.EmptyView>
                    <Label Text="No DroneCAN nodes seen yet. Connect, then check the FC CAN bus number and the Bus traffic panel."
                           Style="{StaticResource Empty}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EscRowViewModel">
                        <Grid ColumnDefinitions="45,110,45,45,55,50,40,60,60,60,55,120,70,130,60,60,60,130,*" ColumnSpacing="6" Padding="6,3">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Label Grid.Column="0" Text="{Binding NodeId}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding Name}" />
                            <Label Grid.Column="2" Text="{Binding ThrottleChannel}" />
                            <Label Grid.Column="3" Text="{Binding ThrottleSource}" />
                            <Label Grid.Column="4" Text="{Binding Rpm}" FontFamily="Consolas" />
                            <Label Grid.Column="5" Text="{Binding Pwm}" FontFamily="Consolas" />
                            <Label Grid.Column="6" Text="{Binding Direction}" />
                            <Label Grid.Column="7" Text="{Binding Voltage}" FontFamily="Consolas" />
                            <Label Grid.Column="8" Text="{Binding Current}" FontFamily="Consolas" />
                            <Label Grid.Column="9" Text="{Binding Power}" FontFamily="Consolas" />
                            <Label Grid.Column="10" Text="{Binding Temperature}" FontFamily="Consolas" />
                            <Label Grid.Column="11" Text="{Binding ExtraTemperatures}" FontFamily="Consolas" />
                            <Label Grid.Column="12" Text="{Binding Status}" FontFamily="Consolas" />
                            <Label Grid.Column="13" Text="{Binding Health}" />
                            <Label Grid.Column="14" Text="{Binding Msg1Set}" FontFamily="Consolas" />
                            <Label Grid.Column="15" Text="{Binding Msg2Set}" FontFamily="Consolas" />
                            <Label Grid.Column="16" Text="{Binding Msg3Set}" FontFamily="Consolas" />
                            <Label Grid.Column="17" Text="{Binding Rates}" FontSize="12" />
                            <Label Grid.Column="18" Text="{Binding Age}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom: configuration | autopilot telemetry + log | bus traffic -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*" ColumnSpacing="16">

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*">
                <Label Grid.Row="0" Text="ArduPilot ESC telemetry" Style="{StaticResource Section}"
                       ToolTipProperties.Text="ESC_TELEMETRY_x_TO_y as reported by the autopilot itself" />
                <Grid Grid.Row="1" ColumnDefinitions="50,55,70,65,50,70,*" Style="{StaticResource HeaderRow}">
                    <Label Grid.Column="0" Text="ESC" Style="{StaticResource Header}" />
                    <Label Grid.Column="1" Text="RPM" Style="{StaticResource Header}" />
                    <Label Grid.Column="2" Text="Voltage" Style="{StaticResource Header}" />
                    <Label Grid.Column="3" Text="Current" Style="{StaticResource Header}" />
                    <Label Grid.Column="4" Text="Temp" Style="{StaticResource Header}" />
                    <Label Grid.Column="5" Text="Consumed" Style="{StaticResource Header}" />
                    <Label Grid.Column="6" Text="Count" Style="{StaticResource Header}" />
                </Grid>
                <VerticalStackLayout Grid.Row="2" BindableLayout.ItemsSource="{Binding AutopilotRows}">
                    <BindableLayout.EmptyView>
                        <Label Text="No ESC_TELEMETRY from the autopilot yet." Style="{StaticResource Empty}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AutopilotEscRowViewModel">
                            <Grid ColumnDefinitions="50,55,70,65,50,70,*" ColumnSpacing="6" Padding="6,2">
                                <Label Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Rpm}" FontFamily="Consolas" />
                                <Label Grid.Column="2" Text="{Binding Voltage}" FontFamily="Consolas" />
                                <Label Grid.Column="3" Text="{Binding Current}" FontFamily="Consolas" />
                                <Label Grid.Column="4" Text="{Binding Temperature}" FontFamily="Consolas" />
                                <Label Grid.Column="5" Text="{Binding Consumed}" FontFamily="Consolas" />
                                <Label Grid.Column="6" Text="{Binding Count}" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Row="3" Spacing="10">
                    <Label Text="Log" Style="{StaticResource Section}" />
                    <Button Text="Clear" Command="{Binding ClearLogCommand}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <ScrollView Grid.Row="4">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Log}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontFamily="Consolas" FontSize="12" LineBreakMode="WordWrap" Padding="4,1" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <Label Grid.Row="0" Text="Bus traffic (transfers per node and type)" Style="{StaticResource Section}" />
                <Grid Grid.Row="1" ColumnDefinitions="40,40,*,65,70,40" Style="{StaticResource HeaderRow}">
                    <Label Grid.Column="0" Text="Node" Style="{StaticResource Header}" />
                    <Label Grid.Column="1" Text="Kind" Style="{StaticResource Header}" />
                    <Label Grid.Column="2" Text="Data type" Style="{StaticResource Header}" />
                    <Label Grid.Column="3" Text="Rate" Style="{StaticResource Header}" />
                    <Label Grid.Column="4" Text="Count" Style="{StaticResource Header}" />
                    <Label Grid.Column="5" Text="Last" Style="{StaticResource Header}" />
                </Grid>
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TrafficRows}">
                        <BindableLayout.EmptyView>
                            <Label Text="No DroneCAN transfers yet." Style="{StaticResource Empty}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrafficRowViewModel">
                                <Grid ColumnDefinitions="40,40,*,65,70,40" ColumnSpacing="6" Padding="6,1">
                                    <Label Grid.Column="0" Text="{Binding NodeId}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding KindText}" FontSize="12" />
                                    <Label Grid.Column="2" Text="{Binding TypeText}" FontSize="12" />
                                    <Label Grid.Column="3" Text="{Binding Rate}" FontFamily="Consolas" FontSize="12" />
                                    <Label Grid.Column="4" Text="{Binding Count}" FontFamily="Consolas" FontSize="12" />
                                    <Label Grid.Column="5" Text="{Binding Age}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                <!-- FlexLayout rows wrap instead of pushing the page wider than the window -->
                <FlexLayout Grid.Row="0" Wrap="Wrap" AlignItems="Center">
                    <Label Text="ESC configuration" Style="{StaticResource Section}" Margin="0,8,8,4" />
                    <Button Text="↻" Command="{Binding ReadConfigCommand}" Margin="0,0,6,0"
                            ToolTipProperties.Text="Read again (the configuration is read automatically when a node is selected)" />
                    <Button Text="Copy report" Command="{Binding CopyReportCommand}" Margin="0,0,6,0" />
                    <Button Text="{Binding ToggleViewText}" Command="{Binding ToggleViewCommand}" Margin="0,0,6,0"
                            ToolTipProperties.Text="Switch between the read-only report and the settings editor" />
                    <Button Text="Presets…" Command="{Binding OpenPresetsCommand}"
                            ToolTipProperties.Text="Save the settings as a preset, or write a saved preset to this ESC" />
                </FlexLayout>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Text="Node" />
                    <Picker Grid.Column="1" ItemsSource="{Binding ConfigNodes}" SelectedItem="{Binding SelectedConfigNode}" />
                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsWriting}" HeightRequest="20" WidthRequest="20" />
                </Grid>

                <!-- Read-only report -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6" IsVisible="{Binding ShowReport}">
                    <HorizontalStackLayout Grid.Row="0" Spacing="6">
                        <CheckBox IsChecked="{Binding IncludeParameters}" />
                        <Label Text="Include params" ToolTipProperties.Text="Also enumerate uavcan.protocol.param.GetSet parameters" />
                        <ActivityIndicator IsRunning="{Binding IsReading}" HeightRequest="20" WidthRequest="20" />
                        <Label Text="{Binding ConfigProgress}" />
                    </HorizontalStackLayout>
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConfigItems}">
                            <BindableLayout.EmptyView>
                                <Label Text="The configuration of the selected ESC node (not the autopilot, usually node 10) is read automatically. The vehicle must be disarmed."
                                       Style="{StaticResource Empty}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="mon:ConfigItem">
                                    <Grid ColumnDefinitions="100,170,*" ColumnSpacing="8" Padding="6,2">
                                        <Label Grid.Column="0" Text="{Binding Group}" FontSize="12" Opacity="0.65" />
                                        <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas" LineBreakMode="CharacterWrap" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <!-- Settings (writes to the ESC) -->
                <ScrollView Grid.Row="2" IsVisible="{Binding ShowSettings}">
                    <!-- keep every row narrow: wide content here widens all three bottom columns -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*,60"
                          RowSpacing="6" ColumnSpacing="8" Padding="0,0,8,0">
                        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="3" Spacing="2">
                            <Label Style="{StaticResource Empty}" Margin="0"
                                   Text="Set = write after confirmation (disarmed only)"
                                   ToolTipProperties.Text="Each write is checked against the ESC's reply and logged" />
                            <Label Style="{StaticResource Empty}" Margin="0" Text="Yellow = changed, not written · Green = written" />
                            <Label Style="{StaticResource Empty}" Margin="0" Text="{Binding SettingsHint}" IsVisible="{Binding HasSettingsHint}"
                                   ToolTipProperties.Text="There is no read-only query for throttle source and LED other than GetMajorConfig (242)" />
                        </VerticalStackLayout>

                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Color="{Binding Marks[NewNodeIdText]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="1" Text="Node ID" />
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding NewNodeIdText}" Keyboard="Numeric" />
                        <Button Grid.Row="1" Grid.Column="2" Text="Set" Command="{Binding SetNodeIdCommand}" />

                        <BoxView Grid.Row="2" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedCanBaud]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="2" Text="CAN speed"
                               ToolTipProperties.Text="ESC CAN bit rate (SetBaud). Cannot be read back; must match the flight controller's CAN_Px_BITRATE" />
                        <Picker Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CanBaudOptions}" SelectedItem="{Binding SelectedCanBaud}" />
                        <Button Grid.Row="2" Grid.Column="2" Text="Set" Command="{Binding SetCanBaudCommand}" />

                        <BoxView Grid.Row="3" Grid.ColumnSpan="2" Color="{Binding Marks[ThrottleChannelText]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="3" Text="Throttle channel" ToolTipProperties.Text="Motor output number ArduPilot uses for this ESC" />
                        <Entry Grid.Row="3" Grid.Column="1" Text="{Binding ThrottleChannelText}" Keyboard="Numeric" />
                        <Button Grid.Row="3" Grid.Column="2" Text="Set" Command="{Binding SetThrottleChannelCommand}" />

                        <BoxView Grid.Row="4" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedThrottleSource]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="4" Text="Throttle source" />
                        <Picker Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ThrottleSourceOptions}" SelectedItem="{Binding SelectedThrottleSource}" />
                        <Button Grid.Row="4" Grid.Column="2" Text="Set" Command="{Binding SetThrottleSourceCommand}" />

                        <BoxView Grid.Row="5" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedMsg1Rate]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="5" Text="StatusMsg1 rate" ToolTipProperties.Text="RPM, PWM, status" />
                        <Picker Grid.Row="5" Grid.Column="1" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding SelectedMsg1Rate}" />
                        <Button Grid.Row="5" Grid.Column="2" Text="Set" Command="{Binding SetRateCommand}" CommandParameter="1" />

                        <BoxView Grid.Row="6" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedMsg2Rate]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="6" Text="StatusMsg2 rate" ToolTipProperties.Text="Voltage, current, temperature" />
                        <Picker Grid.Row="6" Grid.Column="1" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding SelectedMsg2Rate}" />
                        <Button Grid.Row="6" Grid.Column="2" Text="Set" Command="{Binding SetRateCommand}" CommandParameter="2" />

                        <BoxView Grid.Row="7" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedMsg3Rate]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="7" Text="StatusMsg3 rate" ToolTipProperties.Text="MOSFET / capacitor / motor temperatures" />
                        <Picker Grid.Row="7" Grid.Column="1" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding SelectedMsg3Rate}" />
                        <Button Grid.Row="7" Grid.Column="2" Text="Set" Command="{Binding SetRateCommand}" CommandParameter="3" />

                        <BoxView Grid.Row="8" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedLedColor]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="8" Text="LED color" />
                        <Picker Grid.Row="8" Grid.Column="1" ItemsSource="{Binding LedColorOptions}" SelectedItem="{Binding SelectedLedColor}" />

                        <BoxView Grid.Row="9" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedLedBlink]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="9" Text="LED mode" />
                        <HorizontalStackLayout Grid.Row="9" Grid.Column="1" Spacing="6">
                            <Picker ItemsSource="{Binding LedBlinkOptions}" SelectedItem="{Binding SelectedLedBlink}" WidthRequest="120" />
                            <CheckBox IsChecked="{Binding LedSave}" />
                            <Label Text="Save" />
                        </HorizontalStackLayout>
                        <Button Grid.Row="9" Grid.Column="2" Text="Set" Command="{Binding SetLedCommand}" />

                        <BoxView Grid.Row="10" Grid.ColumnSpan="2" Color="{Binding Marks[SelectedDirection]}" CornerRadius="4" Margin="-4,-2" />
                        <Label Grid.Row="10" Text="Direction" />
                        <Picker Grid.Row="10" Grid.Column="1" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" />
                        <Button Grid.Row="10" Grid.Column="2" Text="Set" Command="{Binding SetDirectionCommand}" />
                    </Grid>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Presets popup: an overlay over the whole page, no extra package needed -->
        <Grid Grid.RowSpan="6" Margin="-12" ZIndex="10" BackgroundColor="#99000000" IsVisible="{Binding ShowPresets}">
            <Border WidthRequest="600" MaximumHeightRequest="800" HorizontalOptions="Center" VerticalOptions="Center" Padding="16"
                    StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <ScrollView>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Settings presets" Style="{StaticResource Section}" Margin="0" />
                            <Button Grid.Column="1" Text="Close" Command="{Binding ClosePresetsCommand}" />
                        </Grid>

                        <!-- the same selection as the page: the ESC whose values are shown on the right and that Apply writes to -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Node" />
                            <Picker Grid.Column="1" ItemsSource="{Binding ConfigNodes}" SelectedItem="{Binding SelectedConfigNode}" Title="Choose the ESC" />
                            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsWriting}" HeightRequest="20" WidthRequest="20" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Saved" />
                            <Picker Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Title="Choose a preset to edit or apply" />
                            <Button Grid.Column="2" Text="Delete" Command="{Binding DeletePresetCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Style="{StaticResource Empty}" Margin="0"
                                   Text="Ticked fields belong to the preset; set their values here. Unticked fields are left as they are in the ESC." />
                            <Button Grid.Column="1" Text="From editor" Command="{Binding DraftFromEditorCommand}"
                                    ToolTipProperties.Text="Copy the values of the settings editor (what the ESC reported, plus your edits) into these fields" />
                        </Grid>

                        <Label Style="{StaticResource Empty}" Margin="0"
                               Text="Yellow = differs from the ESC · Green = written · N/A = the ESC does not report it" />

                        <!-- the same fields and order as the settings editor; on the right what the selected ESC reports now -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,120,*,120"
                              RowSpacing="4" ColumnSpacing="6">
                            <Label Grid.Row="0" Grid.Column="2" Text="Preset" FontSize="12" Opacity="0.65" />
                            <Label Grid.Row="0" Grid.Column="3" Text="Current" FontSize="12" Opacity="0.65" />

                            <BoxView Grid.Row="1" Grid.ColumnSpan="4" Color="{Binding DraftMarks[NodeIdText]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="1" IsChecked="{Binding Draft.IncludeNodeId}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="Node ID" ToolTipProperties.Text="1..127" />
                            <Entry Grid.Row="1" Grid.Column="2" Text="{Binding Draft.NodeIdText}" Keyboard="Numeric" />
                            <Label Grid.Row="1" Grid.Column="3" Text="{Binding PresetCurrent[NodeIdText]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="2" Grid.ColumnSpan="4" Color="{Binding DraftMarks[CanBaud]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="2" IsChecked="{Binding Draft.IncludeCanBaud}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="CAN speed" ToolTipProperties.Text="Must match the flight controller's CAN_Px_BITRATE" />
                            <Picker Grid.Row="2" Grid.Column="2" ItemsSource="{Binding CanBaudOptions}" SelectedItem="{Binding Draft.CanBaud}" />
                            <Label Grid.Row="2" Grid.Column="3" Text="{Binding PresetCurrent[CanBaud]}" FontFamily="Consolas"
                                   ToolTipProperties.Text="CAN speed cannot be read back from the ESC" />

                            <BoxView Grid.Row="3" Grid.ColumnSpan="4" Color="{Binding DraftMarks[ThrottleChannelText]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="3" IsChecked="{Binding Draft.IncludeThrottleChannel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="Throttle channel" ToolTipProperties.Text="1..63, the motor output number" />
                            <Entry Grid.Row="3" Grid.Column="2" Text="{Binding Draft.ThrottleChannelText}" Keyboard="Numeric" />
                            <Label Grid.Row="3" Grid.Column="3" Text="{Binding PresetCurrent[ThrottleChannelText]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="4" Grid.ColumnSpan="4" Color="{Binding DraftMarks[ThrottleSource]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="4" IsChecked="{Binding Draft.IncludeThrottleSource}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="Throttle source" />
                            <Picker Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ThrottleSourceOptions}" SelectedItem="{Binding Draft.ThrottleSource}" />
                            <Label Grid.Row="4" Grid.Column="3" Text="{Binding PresetCurrent[ThrottleSource]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="5" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Msg1Rate]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="5" IsChecked="{Binding Draft.IncludeMsg1Rate}" />
                            <Label Grid.Row="5" Grid.Column="1" Text="StatusMsg1 rate" ToolTipProperties.Text="RPM, PWM, status" />
                            <Picker Grid.Row="5" Grid.Column="2" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Draft.Msg1Rate}" />
                            <Label Grid.Row="5" Grid.Column="3" Text="{Binding PresetCurrent[Msg1Rate]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="6" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Msg2Rate]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="6" IsChecked="{Binding Draft.IncludeMsg2Rate}" />
                            <Label Grid.Row="6" Grid.Column="1" Text="StatusMsg2 rate" ToolTipProperties.Text="Voltage, current, temperature" />
                            <Picker Grid.Row="6" Grid.Column="2" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Draft.Msg2Rate}" />
                            <Label Grid.Row="6" Grid.Column="3" Text="{Binding PresetCurrent[Msg2Rate]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="7" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Msg3Rate]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="7" IsChecked="{Binding Draft.IncludeMsg3Rate}" />
                            <Label Grid.Row="7" Grid.Column="1" Text="StatusMsg3 rate" ToolTipProperties.Text="MOSFET / capacitor / motor temperatures" />
                            <Picker Grid.Row="7" Grid.Column="2" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Draft.Msg3Rate}" />
                            <Label Grid.Row="7" Grid.Column="3" Text="{Binding PresetCurrent[Msg3Rate]}" FontFamily="Consolas" />

                            <!-- one tick for colour and mode: SetLED writes both -->
                            <BoxView Grid.Row="8" Grid.ColumnSpan="4" Color="{Binding DraftMarks[LedColor]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="8" IsChecked="{Binding Draft.IncludeLed}" />
                            <Label Grid.Row="8" Grid.Column="1" Text="LED color" />
                            <Picker Grid.Row="8" Grid.Column="2" ItemsSource="{Binding LedColorOptions}" SelectedItem="{Binding Draft.LedColor}" />
                            <Label Grid.Row="8" Grid.Column="3" Text="{Binding PresetCurrent[LedColor]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="9" Grid.ColumnSpan="4" Color="{Binding DraftMarks[LedBlink]}" CornerRadius="4" Margin="-4,-2" />
                            <Label Grid.Row="9" Grid.Column="1" Text="LED mode" />
                            <HorizontalStackLayout Grid.Row="9" Grid.Column="2" Spacing="6">
                                <Picker ItemsSource="{Binding LedBlinkOptions}" SelectedItem="{Binding Draft.LedBlink}" WidthRequest="140" />
                                <CheckBox IsChecked="{Binding Draft.LedSave}" />
                                <Label Text="Save" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="9" Grid.Column="3" Text="{Binding PresetCurrent[LedBlink]}" FontFamily="Consolas" />

                            <BoxView Grid.Row="10" Grid.ColumnSpan="4" Color="{Binding DraftMarks[Direction]}" CornerRadius="4" Margin="-4,-2" />
                            <CheckBox Grid.Row="10" IsChecked="{Binding Draft.IncludeDirection}" />
                            <Label Grid.Row="10" Grid.Column="1" Text="Direction" />
                            <Picker Grid.Row="10" Grid.Column="2" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Draft.Direction}" />
                            <Label Grid.Row="10" Grid.Column="3" Text="{Binding PresetCurrent[Direction]}" FontFamily="Consolas" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Name" />
                            <Entry Grid.Column="1" Text="{Binding PresetName}" Placeholder="e.g. Quad X, 200 Hz" />
                            <Button Grid.Column="2" Text="Save" Command="{Binding SavePresetCommand}" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="0,6" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                        <Label Style="{StaticResource Empty}" Margin="0"
                               Text="Apply writes the ticked fields above to the selected node as they are now (saved or not): one confirmation, then one write after another (disarmed only). Values the ESC already reports are skipped; it stops at the first failed write and shows what was saved." />
                        <Button Text="Apply to ESC" Command="{Binding ApplyPresetCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
